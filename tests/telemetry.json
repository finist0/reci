{
    "comment": "What the apps may send to the server (reci.server, src/index.js). The server rejects any other field, so every platform checks its packets against this list.",
    "ping": {
        "required": ["id", "day", "platform", "app", "os", "locale"],
        "optional": ["cards", "answers", "learned", "lock", "cats", "mode", "theme", "latin", "opened"]
    },
    "answers": ["know", "dontknow", "long", "later", "hide"],
    "platforms": ["android", "ios", "web-ios", "web-android", "web-desktop"],
    "lock": ["widget", "wallpaper", "overlay", "off"],
    "feedback": {
        "required": ["id", "kind", "platform", "app", "os"],
        "optional": ["text", "email", "card", "env"],
        "kinds": ["card", "app", "crash"],
        "crashText": 12000,
        "env": {"maxEntries": 40, "maxString": 120, "name": "^[\\p{L}\\p{N}_:.-]{1,32}$"},
        "card": ["key", "word", "problem", "latin", "stress"],
        "problems": {
            "word": ["translation", "stress", "example", "forms", "other"],
            "article": ["text", "other"]
        }
    }
}
